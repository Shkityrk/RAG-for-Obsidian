# Copy to environment/.env on the server (this file is NOT used automatically).
# cp deploy/env.example environment/.env

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=rag_obsidian
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_strong_password

# --- Auth ---
AUTH_SECRET_KEY=change_me_long_random_secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_HTTP_HOST=0.0.0.0
AUTH_HTTP_PORT=8002
AUTH_PROJECT_NAME=RAG Auth
AUTH_DOCS_URL=/docs
AUTH_OPENAPI_URL=/openapi.json

# Public URL of your app (for CORS), comma-separated if needed
ORIGIN_URLS=http://YOUR_SERVER_IP,http://YOUR_DOMAIN

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=vault-raw
MINIO_SECURE=false
MINIO_ENDPOINT=minio:9000

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=vault_embeddings

# --- OpenRouter (embeddings + LLM) ---
EMBEDDINGS_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=baai/bge-m3
OPENROUTER_LLM_MODEL=google/gemini-3-flash-preview
OPENROUTER_DEEP_RESEARCH_MODEL=perplexity/sonar-deep-research
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=16

# --- Core tuning for 2 GB VPS ---
CORE_MAX_NEW_FILE_WORKERS=2
CORE_DB_BATCH_SIZE=25

# --- Gateway ---
AUTH_SERVICE_URL=http://auth:8002
FILE_CORE_URL=http://file_core:8003
CORE_SERVICE_URL=http://core:8005
